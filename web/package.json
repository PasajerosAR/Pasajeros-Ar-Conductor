{
  "name": "transporte-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "build:driver": "tsc -b && vite build --mode driver",
    "apk:sync": "npm run build:driver && cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.3",
    "@supabase/supabase-js": "^2.119.0",
    "@tomickigrzegorz/leaflet-rotate": "^0.3.0",
    "leaflet": "^1.9.4",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@types/leaflet": "^1.9.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
